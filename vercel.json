{
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/awakening", "destination": "/index.html" },
    { "source": "/sig-stones", "destination": "/index.html" },
    { "source": "/prestige", "destination": "/index.html" },
    { "source": "/immunities", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/tierlist.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
